local shared = odh_shared_plugins

if not shared or type(shared.CreateTab) ~= "function" then
	warn("[Snap Camera] Load through the current Overdrive H plugin menu.")
	return
end

local okTab, tab = pcall(function()
	return shared.CreateTab("Snap Camera", "/Devon67retro/Debug/refs/heads/main/icon")
end)
if not okTab or not tab then return end

local okSec, section = pcall(function()
	return tab:AddSection("Snap Camera", "Face camera forward")
end)
if not okSec or not section then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- 0 = camera looks exactly along your character's facing direction (level).
-- Negative values tilt the camera down (e.g. -10), positive tilt it up.
local PITCH_DEGREES = 0

local BIND_NAME = "SnapCameraForward"
local GUI_NAME = "@SnapCameraGui"

-- ===== Snap =====
-- The default camera script reads the camera's current look direction every frame,
-- so setting the CFrame right after it updates makes it continue from the new angle.
local snapping = false

local function snapCamera()
	if snapping then return end
	snapping = true
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		RunService:UnbindFromRenderStep(BIND_NAME)
		snapping = false

		local cam = workspace.CurrentCamera
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not root then return end

		local fwd = root.CFrame.LookVector
		local flat = Vector3.new(fwd.X, 0, fwd.Z)
		if flat.Magnitude < 1e-3 then return end
		flat = flat.Unit

		local p = math.rad(PITCH_DEGREES)
		local look = flat * math.cos(p) + Vector3.new(0, math.sin(p), 0)

		-- keep your current zoom distance and focus point
		local focus = cam.Focus.Position
		local dist = (cam.CFrame.Position - focus).Magnitude
		if dist < 0.5 then
			-- first person: just rotate in place
			local pos = cam.CFrame.Position
			cam.CFrame = CFrame.lookAt(pos, pos + look)
		else
			cam.CFrame = CFrame.lookAt(focus - look * dist, focus)
		end
	end)
end

-- ===== On-screen draggable button =====
local buttonGui, dragConn

local function getGuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and typeof(ui) == "Instance" then return ui end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function destroyButton()
	if dragConn then
		pcall(function() dragConn:Disconnect() end)
		dragConn = nil
	end
	if buttonGui then
		pcall(function() buttonGui:Destroy() end)
		buttonGui = nil
	end
end

local function createButton()
	if buttonGui then return end

	-- clear a leftover gui from a previous run
	local parent = getGuiParent()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end

	buttonGui = Instance.new("ScreenGui")
	buttonGui.Name = GUI_NAME
	buttonGui.ResetOnSpawn = false
	buttonGui.IgnoreGuiInset = true
	buttonGui.DisplayOrder = 999
	buttonGui.Parent = parent

	local b = Instance.new("TextButton")
	b.Name = "SnapButton"
	b.Size = UDim2.fromOffset(70, 70)
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = UDim2.fromScale(0.85, 0.6)
	b.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	b.BackgroundTransparency = 0.35
	b.Text = "SNAP\nCAM"
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.AutoButtonColor = false
	b.Parent = buttonGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 1.5
	stroke.Parent = b

	-- tap = snap, drag = move the button
	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
	local moved = false

	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = b.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved then snapCamera() end
				end
			end)
		end
	end)

	b.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	dragConn = UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local d = input.Position - dragStart
			if d.Magnitude > 7 then moved = true end
			if moved then
				b.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
end

-- ===== Hub controls =====
pcall(function()
	section:AddToggle("Show Snap Button", function(bool)
		if bool then
			local ok, err = pcall(createButton)
			if not ok then pcall(function() shared.Notify("Snap button error: " .. tostring(err), 4) end) end
		else
			destroyButton()
		end
	end)
end)

pcall(function()
	section:AddButton("Snap Camera Forward", snapCamera)
end)

pcall(function()
	section:AddKeybind("Snap Camera Keybind", "V", snapCamera)
end)
