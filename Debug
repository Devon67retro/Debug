-- Firefly equip fling debugger (standalone, does not need the Firefly Timer script)
-- 1) Run this. 2) Equip the Fireflies jar while standing still. 3) Wait ~3 seconds.
-- It copies a report to your clipboard (and saves FireflyDebug.txt if your executor can).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LP = Players.LocalPlayer

local ITEM = "Fireflies"
local WINDOW = 2.0

local function fmtV(v)
	return string.format("%.1f,%.1f,%.1f", v.X, v.Y, v.Z)
end

local function say(msg)
	pcall(function() odh_shared_plugins.Notify(msg, 6) end)
	print("[FireflyDebug] " .. msg)
end

local busy = false

local function investigate(char, tool)
	if busy then return end
	busy = true

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		busy = false
		return
	end

	local lines = {}
	local function add(s) lines[#lines + 1] = s end

	add("=== FIREFLY EQUIP DEBUG ===")
	add(string.format("at equip: moveDir=%.2f state=%s", hum.MoveDirection.Magnitude, tostring(hum:GetState())))
	add(string.format("humanoid: hip=%.2f walk=%.1f jumpPower=%.1f platformStand=%s sit=%s",
		hum.HipHeight, hum.WalkSpeed, hum.JumpPower, tostring(hum.PlatformStand), tostring(hum.Sit)))
	add(string.format("assemblyMass at equip=%.2f", root.AssemblyMass))

	add("--- tool contents ---")
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			add(string.format("PART %s (%s) size=%s collide=%s massless=%s anchored=%s mass=%.2f fromRoot=%s",
				d.Name, d.ClassName, fmtV(d.Size), tostring(d.CanCollide), tostring(d.Massless),
				tostring(d.Anchored), d:GetMass(), fmtV(root.CFrame:PointToObjectSpace(d.Position))))
			local okO, hits = pcall(function()
				local p = OverlapParams.new()
				p.FilterType = Enum.RaycastFilterType.Exclude
				p.FilterDescendantsInstances = { char }
				return Workspace:GetPartsInPart(d, p)
			end)
			if okO and hits and #hits > 0 then
				local names = {}
				for i = 1, math.min(#hits, 6) do names[#names + 1] = hits[i]:GetFullName() end
				add("   overlaps world: " .. table.concat(names, " | "))
			end
		elseif d:IsA("LuaSourceContainer") then
			add("SCRIPT " .. d.ClassName .. " " .. d.Name)
		elseif d:IsA("BodyMover") or d:IsA("Constraint") then
			add("FORCE/CONSTRAINT " .. d.ClassName .. " " .. d.Name)
		elseif d:IsA("JointInstance") then
			add("JOINT " .. d.ClassName .. " " .. d.Name)
		end
	end

	-- things that appear while the window is open
	local t0 = os.clock()
	local events = {}
	local function ev(s)
		if #events < 30 then events[#events + 1] = string.format("%.2fs %s", os.clock() - t0, s) end
	end

	local c1 = hum.StateChanged:Connect(function(_, new)
		ev("STATE -> " .. tostring(new))
	end)
	local c2 = Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and not d:IsDescendantOf(char) then
			local dist = (d.Position - root.Position).Magnitude
			if dist < 30 then
				ev(string.format("WORLD ADDED %s (%s) dist=%.1f size=%s collide=%s anchored=%s",
					d:GetFullName(), d.ClassName, dist, fmtV(d.Size), tostring(d.CanCollide), tostring(d.Anchored)))
			end
		end
	end)
	local c3 = char.DescendantAdded:Connect(function(d)
		if not d:IsDescendantOf(tool) then
			ev("CHARACTER ADDED " .. d.ClassName .. " " .. d.Name)
		end
	end)

	-- per-frame trace
	local samples = {}
	local lastPos = root.Position
	local maxStep, maxStepT = 0, 0
	local maxSpeed, maxSpeedT = 0, 0
	local maxUp = 0
	local frame = 0
	local nextSample = 0
	while os.clock() - t0 < WINDOW and char.Parent do
		RunService.Heartbeat:Wait()
		frame = frame + 1
		local now = os.clock() - t0
		local p = root.Position
		local step = (p - lastPos).Magnitude
		lastPos = p
		local v = root.AssemblyLinearVelocity
		if step > maxStep then maxStep, maxStepT = step, now end
		if v.Magnitude > maxSpeed then maxSpeed, maxSpeedT = v.Magnitude, now end
		if v.Y > maxUp then maxUp = v.Y end
		if frame <= 12 or now >= nextSample then
			if now >= nextSample then nextSample = now + 0.1 end
			samples[#samples + 1] = string.format("%.2fs vel=%s step=%.2f state=%s moveDir=%.1f",
				now, fmtV(v), step, tostring(hum:GetState()), hum.MoveDirection.Magnitude)
		end
	end

	c1:Disconnect()
	c2:Disconnect()
	c3:Disconnect()

	add("--- summary ---")
	add(string.format("biggest single-frame position jump: %.2f studs at %.2fs", maxStep, maxStepT))
	add(string.format("highest speed: %.1f at %.2fs, highest upward speed: %.1f", maxSpeed, maxSpeedT, maxUp))
	add(string.format("assemblyMass at end=%.2f", root.AssemblyMass))
	add("--- events ---")
	for _, e in ipairs(events) do add(e) end
	add("--- trace ---")
	for _, s in ipairs(samples) do add(s) end

	local report = table.concat(lines, "\n")
	local copied = false
	pcall(function()
		if type(setclipboard) == "function" then
			setclipboard(report)
			copied = true
		end
	end)
	pcall(function()
		if type(writefile) == "function" then writefile("FireflyDebug.txt", report) end
	end)
	print(report)
	if copied then
		say("Report copied to clipboard. Paste it to Claude.")
	else
		say("Report printed to console / FireflyDebug.txt (no clipboard support).")
	end
	busy = false
end

local function arm(char)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == ITEM then
			task.spawn(investigate, char, child)
		end
	end)
end

if LP.Character then arm(LP.Character) end
LP.CharacterAdded:Connect(arm)

say("Firefly debug armed. Equip the jar (stand still), then wait 3 seconds.")
