local shared = odh_shared_plugins

if not shared or type(shared.CreateTab) ~= "function" then
	warn("[Snap Camera] Load through the current Overdrive H plugin menu.")
	return
end

local okTab, tab = pcall(function()
	return shared.CreateTab("Snap Camera", "/Devon67retro/Debug/refs/heads/main/icon")
end)
if not okTab or not tab then return end

local okSec, section = pcall(function()
	return tab:AddSection("Snap Camera", "Camera in front of avatar")
end)
if not okSec or not section then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- The camera snaps in front of your character, looking straight back at it (level).
-- Negative values tilt the camera down (e.g. -10), positive tilt it up.
local PITCH_DEGREES = 0

local BIND_NAME = "SnapCameraForward"
local GUI_NAME = "@SnapCameraGui"

-- ===== Snap =====
-- To avoid any fighting with the default camera script (the cause of random flicker),
-- the camera is switched to Scriptable for the short glide, driven entirely by this
-- script (with its own wall check), then handed back to the default camera.

-- Seconds the camera takes to glide to the new angle. 0 = instant.
local SMOOTH_TIME = 0.25

local snapping = false

-- make sure a leftover bind from a previous run can't double-drive the camera
pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)

-- your real zoom setting (not the wall-shortened distance)
local function getZoomDistance(cam, focus)
	local ok, z = pcall(function()
		local pm = require(LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule"))
		local ctrl = pm:GetCameras().activeCameraController
		return ctrl and ctrl:GetCameraToSubjectDistance()
	end)
	if ok and type(z) == "number" and z > 0 then return z end
	return (cam.CFrame.Position - focus).Magnitude
end

local function snapCamera()
	if snapping then return end

	local cam = workspace.CurrentCamera
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not cam or not root then return end

	local fwd = root.CFrame.LookVector
	local flat = Vector3.new(fwd.X, 0, fwd.Z)
	if flat.Magnitude < 1e-3 then return end
	flat = flat.Unit

	-- target: camera IN FRONT of the avatar, looking back at it
	local targetYaw = math.atan2(-flat.X, -flat.Z)
	local targetPitch = math.rad(PITCH_DEGREES)

	-- start: where the camera is looking right now
	local cur = cam.CFrame.LookVector
	local startYaw = math.atan2(cur.X, cur.Z)
	local startPitch = math.asin(math.clamp(cur.Y, -1, 1))

	-- turn the short way round
	local deltaYaw = (targetYaw - startYaw + math.pi) % (2 * math.pi) - math.pi

	local focus0 = cam.Focus.Position
	local pos0 = cam.CFrame.Position
	local rootPos0 = root.Position
	local zoom = getZoomDistance(cam, focus0)
	local firstPerson = zoom < 0.5

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char }
	rayParams.IgnoreWater = true
	pcall(function() rayParams.RespectCanCollide = true end)

	local prevType = cam.CameraType
	local takeOver = prevType ~= Enum.CameraType.Scriptable
	if takeOver then cam.CameraType = Enum.CameraType.Scriptable end

	snapping = true
	local t0 = os.clock()
	local finished = false

	local function finish()
		if finished then return end
		finished = true
		pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
		if takeOver then pcall(function() cam.CameraType = prevType end) end
		snapping = false
	end

	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if workspace.CurrentCamera ~= cam or not root.Parent then
			finish()
			return
		end

		local a = 1
		if SMOOTH_TIME > 0 then
			a = math.clamp((os.clock() - t0) / SMOOTH_TIME, 0, 1)
		end
		local e = 1 - (1 - a) ^ 3 -- ease out

		local ok = pcall(function()
			local yaw = startYaw + deltaYaw * e
			local pitch = startPitch + (targetPitch - startPitch) * e
			local look = Vector3.new(
				math.sin(yaw) * math.cos(pitch),
				math.sin(pitch),
				math.cos(yaw) * math.cos(pitch)
			)

			-- follow the character if it moves during the glide
			local shift = root.Position - rootPos0

			if firstPerson then
				local pos = pos0 + shift
				cam.CFrame = CFrame.lookAt(pos, pos + look)
			else
				local focus = focus0 + shift
				local want = focus - look * zoom
				local offset = want - focus
				local pos = want
				local hit = workspace:Raycast(focus, offset, rayParams)
				if hit then
					pos = focus + offset.Unit * math.max(hit.Distance - 0.3, 0.5)
				end
				cam.CFrame = CFrame.lookAt(pos, focus)
				cam.Focus = CFrame.new(focus)
			end
		end)

		if a >= 1 or not ok then finish() end
	end)
end

-- ===== On-screen draggable button =====
local POS_FILE = "SnapCamera_ButtonPos.json"
local ACCENT_A = Color3.fromRGB(0, 170, 255)
local ACCENT_B = Color3.fromRGB(150, 70, 255)

local buttonGui, snapButton, dragConn, glowConn

local function notify(msg)
	pcall(function() shared.Notify(msg, 3) end)
end

local function getGuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and typeof(ui) == "Instance" then return ui end
	return LocalPlayer:WaitForChild("PlayerGui")
end

-- saved position is stored as screen fractions (0-1)
local function loadSavedPos()
	local ok, result = pcall(function()
		if isfile and readfile and isfile(POS_FILE) then
			return HttpService:JSONDecode(readfile(POS_FILE))
		end
	end)
	if ok and type(result) == "table" and type(result.x) == "number" and type(result.y) == "number" then
		return UDim2.fromScale(math.clamp(result.x, 0.03, 0.97), math.clamp(result.y, 0.03, 0.97))
	end
	return nil
end

local function savePosition()
	if not (buttonGui and snapButton) then
		notify("Turn on Show Snap Button first")
		return
	end
	local size = buttonGui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return end
	local p = snapButton.Position
	local x = math.clamp(p.X.Scale + p.X.Offset / size.X, 0.03, 0.97)
	local y = math.clamp(p.Y.Scale + p.Y.Offset / size.Y, 0.03, 0.97)
	local wrote = false
	pcall(function()
		if writefile then
			writefile(POS_FILE, HttpService:JSONEncode({ x = x, y = y }))
			wrote = true
		end
	end)
	if wrote then
		notify("Button position saved")
	else
		notify("Executor can't save files")
	end
end

local function destroyButton()
	if dragConn then
		pcall(function() dragConn:Disconnect() end)
		dragConn = nil
	end
	if glowConn then
		pcall(function() glowConn:Disconnect() end)
		glowConn = nil
	end
	if buttonGui then
		pcall(function() buttonGui:Destroy() end)
		buttonGui = nil
	end
	snapButton = nil
end

local function createButton()
	if buttonGui then return end

	-- clear a leftover gui from a previous run
	local parent = getGuiParent()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end

	buttonGui = Instance.new("ScreenGui")
	buttonGui.Name = GUI_NAME
	buttonGui.ResetOnSpawn = false
	buttonGui.IgnoreGuiInset = true
	buttonGui.DisplayOrder = 999
	buttonGui.Parent = parent

	local b = Instance.new("TextButton")
	b.Name = "SnapButton"
	b.Size = UDim2.fromOffset(72, 72)
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = loadSavedPos() or UDim2.fromScale(0.85, 0.6)
	b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	b.BackgroundTransparency = 0.1
	b.Text = ""
	b.AutoButtonColor = false
	b.Parent = buttonGui
	snapButton = b

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b

	-- dark glass body
	local body = Instance.new("UIGradient")
	body.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 38, 66)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 11, 20)),
	})
	body.Rotation = 90
	body.Parent = b

	-- glowing ring that slowly rotates
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b

	local ring = Instance.new("UIGradient")
	ring.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, ACCENT_A),
		ColorSequenceKeypoint.new(0.5, ACCENT_B),
		ColorSequenceKeypoint.new(1, ACCENT_A),
	})
	ring.Parent = stroke

	glowConn = RunService.RenderStepped:Connect(function()
		ring.Rotation = (ring.Rotation + 1.5) % 360
	end)

	-- label
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.38)
	title.Position = UDim2.fromScale(0, 0.2)
	title.Text = "SNAP"
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 17
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Active = false
	title.Parent = b

	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Size = UDim2.fromScale(1, 0.26)
	sub.Position = UDim2.fromScale(0, 0.52)
	sub.Text = "CAM"
	sub.Font = Enum.Font.GothamBold
	sub.TextSize = 11
	sub.TextColor3 = Color3.fromRGB(140, 175, 255)
	sub.Active = false
	sub.Parent = b

	-- press feedback
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local pressInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local flashInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function press()
		TweenService:Create(scale, pressInfo, { Scale = 1.12 }):Play()
	end

	local function release(didSnap)
		TweenService:Create(scale, pressInfo, { Scale = 1 }):Play()
		if didSnap then
			stroke.Thickness = 6
			TweenService:Create(stroke, flashInfo, { Thickness = 2.5 }):Play()
		end
	end

	-- tap = snap, drag = move the button
	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
	local moved = false

	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = b.Position
			press()
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					release(not moved)
					if not moved then snapCamera() end
				end
			end)
		end
	end)

	b.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	dragConn = UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local d = input.Position - dragStart
			if d.Magnitude > 7 then moved = true end
			if moved then
				b.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
end

-- ===== Hub controls =====
pcall(function()
	section:AddToggle("Show Snap Button", function(bool)
		if bool then
			local ok, err = pcall(createButton)
			if not ok then pcall(function() shared.Notify("Snap button error: " .. tostring(err), 4) end) end
		else
			destroyButton()
		end
	end)
end)

pcall(function()
	section:AddButton("Save Button Position", savePosition)
end)

pcall(function()
	section:AddButton("Snap Camera In Front", snapCamera)
end)

pcall(function()
	section:AddKeybind("Snap Camera Keybind", "V", snapCamera)
end)
